@echo off
%SystemRoot%\System32\chcp.com 65001 >nul
cd /d "%~dp0"
title 62服务器端口与服务统计
echo.
echo  正在采集本机端口与服务占用信息，请稍候...
echo.
%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 (
  echo  [提示] 采集出现问题，可尝试右键本文件，选择以管理员身份运行后重试。
)
echo.
echo  完成。报告已生成本文件夹内并自动打开浏览器展示。
pause
