# TestAI Community 环境配置
# 用法：复制本文件为 .env
# A = 开发目录（如 testai_community）  B = 生产目录（如 testai_community_prod）
# 详见 doc/deploy_ab_same_pc.md

# ---------- LLM API Key ----------
MINIMAX_API_KEY=
MIMO_API_KEY=
TAVILY_API_KEY=

# ---------- 运行环境：dev（A 开发）| production（B 生产） ----------
ENV=dev

# ---------- 服务端口（A/B 错开，可同时运行） ----------
# A 开发示例：48010 / 3003
# B 生产示例：48011 / （生产一般只访问 BACKEND_PORT，可不启前端 dev）
BACKEND_PORT=48010
FRONTEND_PORT=3003

# ---------- 数据库（A/B 必须各用各的文件，禁止共用） ----------
# A 开发：
DATABASE_URL=sqlite:///./database_dev.sqlite
# B 生产（复制到生产目录的 .env 中改为）：
# DATABASE_URL=sqlite:///./database_prod.sqlite

# ---------- Translate 数据目录（可选；默认 backend/app/uploads 与 results） ----------
# A 开发可保持默认；B 生产若目录分离可显式指定，例如：
# TRANSLATE_UPLOAD_DIR=G:/deploy/testai_community_prod/backend/app/uploads
# TRANSLATE_RESULT_DIR=G:/deploy/testai_community_prod/backend/app/results

# ---------- 认证（B 生产必须设置强随机 SECRET_KEY） ----------
# SECRET_KEY=
# A 开发可不设（使用 insecure default）；B 生产 ENV=production 时必须设置

# ---------- 其它可选 ----------
# MINIMAX_API_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M2.7-highspeed
# TAVILY_SEARCH_URL=https://api.tavily.com/search
# AI_NEWS_OUTPUT_DIR=G:/deploy/testai_community/data/ai_news
# MAX_CONCURRENT_JOBS=1
# CORS_ORIGINS=*
