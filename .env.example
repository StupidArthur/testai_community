# TestAI Community 环境配置
# 用法：复制本文件为 .env
# A = 开发目录（如 testai_community）  B = 生产目录（如 testai_community_prod）
# 详见 doc/deploy_ab_same_pc.md

# ---------- LLM API Key ----------
MINIMAX_API_KEY=
MIMO_API_KEY=
TAVILY_API_KEY=

# ---------- Ollama（本地 Embedding / 视觉，免费） ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_VL_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=bge-m3

# ---------- 知识库（可选） ----------
# KNOWLEDGE_BASE_DATA_DIR=G:/deploy/testai_community/data/knowledge_base
# KNOWLEDGE_BASE_CHROMA_DIR=G:/deploy/testai_community/data/knowledge_base/chroma
# KB_MAX_UPLOAD_MB=30
# KB_MAX_TOTAL_MB=500
# KB_MAX_DOCS_PER_KB=100
# KB_MAX_CONCURRENT_JOBS=2
# KB_CHUNK_SIZE=800
# KB_CHUNK_OVERLAP=120
# KB_RAG_TOP_K=6
# 旧版 .doc：默认使用 <项目根>/tools/LibreOffice；A/B 环境各自用各自目录下的 tools，无需改路径。
# 若使用系统安装版可指定：
# LIBREOFFICE_SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.com
# 转换失败时运行：powershell -ExecutionPolicy Bypass -File scripts/ensure_libreoffice.ps1
# LIBREOFFICE_PROFILE_DIR=G:/deploy/testai_community/data/libreoffice_profile

# ---------- 运行环境：dev（A 开发）| production（B 生产） ----------
ENV=dev

# ---------- 服务端口（A/B 错开，可同时运行） ----------
# A 开发示例：48010 / 3003
# B 生产示例：48011 / （生产一般只访问 BACKEND_PORT，可不启前端 dev）
BACKEND_PORT=48010
FRONTEND_PORT=3003

# ---------- 数据库（A/B 必须各用各的文件，禁止共用） ----------
# A 开发：
DATABASE_URL=sqlite:///./database_dev.sqlite
# B 生产（复制到生产目录的 .env 中改为）：
# DATABASE_URL=sqlite:///./database_prod.sqlite

# ---------- Translate 数据目录（可选；默认 backend/app/uploads 与 results） ----------
# A 开发可保持默认；B 生产若目录分离可显式指定，例如：
# TRANSLATE_UPLOAD_DIR=G:/deploy/testai_community_prod/backend/app/uploads
# TRANSLATE_RESULT_DIR=G:/deploy/testai_community_prod/backend/app/results

# ---------- Tool Hub 客户端工具制品目录（可选） ----------
# TOOL_HUB_ARTIFACT_DIR=G:/deploy/testai_community_prod/backend/app/tool_artifacts

# ---------- 认证（B 生产必须设置强随机 SECRET_KEY） ----------
# SECRET_KEY=
# A 开发可不设（使用 insecure default）；B 生产 ENV=production 时必须设置

# ---------- 钉钉群推送（测试任务日报 / 周报）----------
# 自定义机器人 Webhook（含 access_token）；勿提交到 git
# 例：https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_WEBHOOK_URL=
# 与钉钉机器人「自定义关键词」一致（默认 msg）
DINGTALK_KEYWORD=msg
# 是否启用进程内定时推送（true/false）。推荐改用 Windows 计划任务，此时请设 false 防重复发送
DINGTALK_PUSH_ENABLED=false
# 日报：每天该时刻后首次推送（UTC+8）；默认 20:00（日更截止 19:50）
# DINGTALK_DAILY_PUSH_HOUR=20
# DINGTALK_DAILY_PUSH_MINUTE=0
# 日更锁定：TM_DAILY_EDIT_LOCK_HOUR=19 / TM_DAILY_EDIT_LOCK_MINUTE=50
# Windows 计划任务安装：backend\scripts\install_wecom_scheduled_tasks.ps1
# 推送脚本：backend\scripts\wecom_scheduled_push.py（环境变量 TM_PUSH_KIND=daily|weekly）
# 周报：星期几（Mon=0 … Wed=2）该时刻后首次推送（实际以 week_end+15min 为准）
# DINGTALK_WEEKLY_PUSH_WEEKDAY=2
# DINGTALK_WEEKLY_PUSH_HOUR=17
# DINGTALK_WEEKLY_PUSH_MINUTE=30

# ---------- 其它可选 ----------
# MINIMAX_API_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M2.7-highspeed
# TAVILY_SEARCH_URL=https://api.tavily.com/search
# AI_NEWS_OUTPUT_DIR=G:/deploy/testai_community/data/ai_news
# MAX_CONCURRENT_JOBS=1
# CORS_ORIGINS=*
