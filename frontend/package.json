{
    "name": "qa-skillhub-frontend",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "test": "vitest run src",
        "test:watch": "vitest src",
        "test:e2e": "cross-env PW_DISABLE_TS_ESM=1 playwright test",
        "test:e2e:ui": "cross-env PW_DISABLE_TS_ESM=1 playwright test --ui",
        "test:e2e:report": "playwright show-report e2e-report"
    },
    "dependencies": {
        "@ant-design/icons": "^6.2.5",
        "@ant-design/pro-components": "^2.8.10",
        "@fontsource/geist-sans": "^5.2.5",
        "@tanstack/react-query": "^5.101.0",
        "@tanstack/react-query-devtools": "^5.101.0",
        "antd": "^5.29.3",
        "axios": "^1.7.2",
        "dayjs": "^1.11.13",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.17.0",
        "remark-gfm": "^4.0.1",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@playwright/test": "^1.52.0",
        "@types/node": "^24.12.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "cross-env": "^10.1.0",
        "typescript": "~6.0.2",
        "vite": "^8.0.12",
        "vitest": "^3.2.4"
    }
}
